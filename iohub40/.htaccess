<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Redirecionar index.html para a raiz / (301)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/index\.html [NC]
    RewriteRule ^index\.html$ https://iohub40.com.br/ [R=301,L]

    # 2. Forçar HTTPS e sem www em uma única regra (301)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.iohub40\.com\.br$ [NC]
    RewriteRule ^(.*)$ https://iohub40.com.br/$1 [R=301,L]

    # 3. Se acessar com .html na URL (exceto index), redireciona 301 para a versão limpa
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP [NC]
    RewriteRule ^([^.]+)\.html$ /$1 [R=301,L]

    # 4. Se acessar URL limpa, busca o arquivo .html internamente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Compressão Gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/javascript
</IfModule>

# Cache de Navegador para Assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
